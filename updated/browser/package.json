{
  "name": "robotrun-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "npm run prepare:assets && vite --host 127.0.0.1",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "build": "npm run prepare:assets && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.2.3",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/three": "0.183.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
